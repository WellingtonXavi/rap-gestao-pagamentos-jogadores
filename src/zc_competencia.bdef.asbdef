projection;
strict ( 2 );
use draft;

define behavior for ZC_COMPETENCIA alias Competencia
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Pagamento { create; with draft; }
}

define behavior for ZC_PAGAMENTO alias Pagamento
{

  use update;
  use delete;

  use association _Competencia { with draft; }
}